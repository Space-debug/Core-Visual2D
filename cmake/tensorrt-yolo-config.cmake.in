# Visual2DInferConfig.cmake.in
# - This file is generated by CMake and should not be edited manually.

# Set the package version
set(Visual2DInfer_VERSION "@PACKAGE_VERSION@")

# Set the root directory of the package
set(Visual2DInfer_DIRS "@PACKAGE_DIRS@")

# Set the include directory
set(Visual2DInfer_INCLUDE_DIRS "@PACKAGE_INCLUDE_DIRS@")

# Set the library directory
set(Visual2DInfer_LIBRARY_DIRS "@PACKAGE_LIBRARY_DIRS@")

# Set the library dependencies (all libraries in the project)
set(Visual2DInfer_LIBRARIES "@PACKAGE_LIBRARIES@")

# Add the library directories to the linker
link_directories("${Visual2DInfer_LIBRARY_DIRS}")

# Print the found information
message(STATUS "Found Visual2DInfer: ${Visual2DInfer_DIRS} (found version \"${Visual2DInfer_VERSION}\")")
message(STATUS "  Include directories: ${Visual2DInfer_INCLUDE_DIRS}")
message(STATUS "  Library directories: ${Visual2DInfer_LIBRARY_DIRS}")
message(STATUS "  Libraries: ${Visual2DInfer_LIBRARIES}")